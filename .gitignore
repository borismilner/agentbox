/agentbox
/dist/
*.test
*.out
.idea/
/frontend/node_modules/

# Office editors drop a lock file beside the document they have open; one of
# these was committed with the deck.
.~lock.*#

# A throwaway venv for the one script that needs python-pptx (make deck).
/.venv-deck/

# Python bytecode from the showcase tools; one of these was committed once.
__pycache__/
*.pyc
.wiki-build/

# Working notes live in ../logbook (see that repo's CONVENTION.md). CLAUDE.md and
# .claude/settings.json are symlinks into it, because the tooling reads them from
# here; the rest is read from there directly and has no copy in this tree.
/CLAUDE.md
/.claude
/HANDOFF.md
/docs/STATUS.md
/docs/history.md
/docs/07-field-requests.md
/docs/backlog

# 2026-08-23. ~/.gitignore_global carries `**/CLAUDE.md` and `.claude/`, so the
# hand-written working agreement and the accumulated permission allowlist here were
# tracked by nothing and pushed nowhere. The laptop is being wiped, so that meant
# losing them outright. Versioned now, scoped to the settings files only.
!**/CLAUDE.md
!**/.claude/
**/.claude/*
!**/.claude/settings.json
!**/.claude/settings.local.json

# ...except the root CLAUDE.md, which is a symlink into ../logbook by design.
# The real file is versioned there; logbook/SETUP.md remakes the link.
/CLAUDE.md
