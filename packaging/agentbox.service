[Unit]
Description=agentbox - desktop interaction hub for AI agents
Documentation=https://gitlab.com/fu-bar/agentbox
# Bind to the graphical session so agentbox starts with the desktop and stops
# with it; it needs DISPLAY/WAYLAND_DISPLAY and the session D-Bus.
PartOf=graphical-session.target
After=graphical-session.target

# The restart budget, written down rather than inherited (R-24). The defaults are
# five starts in ten seconds, and with RestartSec=2 below that is five restarts
# and then the unit is `failed` forever - eight seconds after a crash loop began,
# with nothing on screen saying so. What made it invisible is that agentbox is
# auto-spawned by the first MCP call, so a daemon comes back anyway and serves
# unmanaged while the unit sits inactive.
#
# Ten in five minutes instead. It is more forgiving of a fast transient (ten
# tries rather than five) and it catches the slow loop the default cannot see at
# all: a daemon dying every thirty seconds passes a ten-second window forever.
# The limit is still real, because a daemon that cannot start must eventually
# stop trying - `agentbox status` reports the unit state so that is a sentence
# somebody reads rather than a silence.
#
# These two belong in [Unit] and not in [Service]: they moved in systemd 229, and
# in the wrong section they are accepted and ignored.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/agentbox daemon
# NO ExecStop. It was `agentbox quit`, and it made enabling this unit DESTROY the
# daemon it was supposed to manage: agentbox is single-instance by flock and
# auto-spawns on the first client call, so `agentbox daemon` prints "already running"
# and exits 0 when one is up. systemd sees a Type=simple main process exit
# successfully, considers the service finished, and runs ExecStop - which quit the
# healthy daemon that was already serving. Enabling the unit left the desktop with
# no agentbox at all.
#
# It was redundant as well as harmful: the daemon handles SIGTERM, which is what
# systemd sends on stop, and that path drains through the same graceful shutdown
# `agentbox quit` uses (cmd/agentbox/daemon.go, signal.Notify).
#
# The remaining wrinkle is cosmetic: start this while a daemon is already up and
# the unit reports inactive while that daemon keeps serving. At login - the case
# this unit exists for - nothing is running yet, so it starts one and stays active.
# Robustness: if the daemon ever crashes, bring it back rather than leaving the
# desktop without its interaction hub.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
